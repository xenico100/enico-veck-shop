# PayPal (one-time order flow + Studio subscription flow)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# PayPal Studio monthly subscription (server-only)
PAYPAL_WEBHOOK_ID=
# Legacy single-plan fallback (used as 4,900원 tier fallback)
PAYPAL_PLAN_ID_MONTHLY=
# Multi-plan Studio memberships (recommended)
PAYPAL_PLAN_ID_MONTHLY_4900=
PAYPAL_PLAN_ID_MONTHLY_13900=
PAYPAL_PLAN_ID_MONTHLY_69000=

# Cloudflare R2 (private bucket for Studio media)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Admin sales notification email (orders + membership joins)
# Alert recipient defaults to morba9850@gmail.com if SALES_ALERT_TO_EMAIL is empty.
SALES_ALERT_EMAIL_ENABLED=true
SALES_ALERT_TO_EMAIL=morba9850@gmail.com
