R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Admin sales notification email (orders + membership joins)
# New member signup notifications reuse this Resend recipient/sender configuration.
# Alert recipient defaults to morba9850@gmail.com if SALES_ALERT_TO_EMAIL is empty.
SALES_ALERT_EMAIL_ENABLED=true
SALES_ALERT_TO_EMAIL=morba9850@gmail.com
SALES_ALERT_FROM_EMAIL=onboarding@resend.dev
RESEND_API_KEY=

# Server-only Auth INSERT webhook secret: at least 32 random characters.
# Configure the same value in the database webhook x-signup-webhook-secret header.
SIGNUP_NOTIFICATION_WEBHOOK_SECRET=
# Optional signup-only settings; never enable unrelated sales mail as a side effect.
SIGNUP_NOTIFICATION_RESEND_API_KEY=
SIGNUP_NOTIFICATION_FROM_EMAIL=
SIGNUP_NOTIFICATION_EMAIL=
# Omit this variable until setting a valid ISO 8601 activation timestamp.
# SIGNUP_NOTIFICATION_ENABLED_AT=2026-11-04T10:00:00.000Z

# Optional 3D prototype workshop. SERVER ONLY; never prefix these with NEXT_PUBLIC_.
# One verified Supabase owner user UUID. Empty/invalid values disable the API.
WORLD_OWNER_USER_ID=
# Optional private Drive folder/file link; returned only after server owner verification.
WORLD_WORKSHOP_DRIVE_URL=
